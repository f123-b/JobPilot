APP_NAME=JobPilot
DATABASE_PATH=data/jobpilot.db

# OpenAI-compatible LLM + embeddings (optional; offline fallback is available)
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_DIM=1536
VECTOR_DIM=1536

# Resume RAG vector backend: auto | sqlite | postgres
VECTOR_BACKEND=auto
POSTGRES_URL=

# LangGraph persistence: auto | sqlite | postgres | memory
CHECKPOINT_BACKEND=auto
CHECKPOINT_PATH=data/checkpoints.sqlite

# Browser Use Cloud model (optional alternative)
BROWSER_USE_API_KEY=
BROWSER_MODEL=bu-2-0-mini-preview
BROWSER_MAX_STEPS=30
BROWSER_HEADLESS=false

# Agent quality gate / retry
AGENT_MAX_RETRIES=2
EVAL_MIN_SCORE=65
