APP_NAME=JobPilot

# Application database: SQLite by default; production can use PostgreSQL.
DATABASE_BACKEND=auto
DATABASE_PATH=data/jobpilot.db
DATABASE_URL=
# If DATABASE_BACKEND=postgres and DATABASE_URL is empty, POSTGRES_URL is used.
USE_POSTGRES_APP_DB=false
POSTGRES_URL=

# OpenAI-compatible LLM + embeddings (optional; offline fallback is available)
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_DIM=1536
VECTOR_DIM=1536

# Resume RAG vector backend: auto | sqlite | postgres
VECTOR_BACKEND=auto

# LangGraph persistence: auto | sqlite | postgres | memory
CHECKPOINT_BACKEND=auto
CHECKPOINT_PATH=data/checkpoints.sqlite

# Browser Use
BROWSER_USE_API_KEY=
BROWSER_MODEL=bu-2-0-mini-preview
BROWSER_MAX_STEPS=30
BROWSER_HEADLESS=false

# Agent quality gate / retry
AGENT_MAX_RETRIES=2
EVAL_MIN_SCORE=65

# Durable worker. In docker-compose the API disables its embedded worker and a
# separate worker container consumes the same PostgreSQL-backed queue.
WORKER_ENABLED=true
WORKER_POLL_SECONDS=0.75
WORKER_LEASE_SECONDS=180
WORKER_MAX_ATTEMPTS=3

# Cost accounting: set according to the provider/model you actually use.
LLM_INPUT_COST_PER_1M=0
LLM_OUTPUT_COST_PER_1M=0
EMBEDDING_COST_PER_1M=0

# OpenTelemetry (optional). Without it, /api/metrics/summary still works.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=jobpilot
OTEL_EXPORTER_OTLP_ENDPOINT=
